{
  "name": "buwl-hu/oeny-hrsz",
  "version": "1.0.0",
  "description": "Lightweight PHP 8.3+ client for the publicly accessible OÉNY HRSZ kereső endpoints.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Buwl",
      "role": "Developer"
    },
    {
      "name": "OpenAI",
      "role": "Contributor"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "BuwlOpenAI\\OenyHrsz\\": "src/"
    },
    "files": [
      "src/Config/constants.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "BuwlOpenAI\\OenyHrsz\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit"
  }
}
